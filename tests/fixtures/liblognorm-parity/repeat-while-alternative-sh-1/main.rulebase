version=2
rule=:a %{"name":"numbers", "type":"repeat",
			"parser":[
			    {"name":"n1", "type":"number"},
			    {"type":"literal", "text":":"},
			    {"name":"n2", "type":"number"}
			  ],
			"while": {
			    "type":"alternative", "parser": [
			        {"type":"literal", "text":", "},
			        {"type":"literal", "text":","}
			     ]
			 }
       		   }% b %w:word%

